---
import { Icon } from 'astro-icon/components';

interface Props {
  href: string;
  label: string;
  detail: string;
  icon: string;
  iconClass?: string;
  external?: boolean;
  title?: string;
}

const {
  href,
  label,
  detail,
  icon,
  iconClass,
  external = false,
  title,
} = Astro.props;
---

<a
  class="group flex min-h-20 items-center gap-3 rounded-xl border border-neutral-200 bg-white p-3 text-left no-underline transition duration-200 hover:-translate-y-0.5 hover:border-green-700 hover:shadow-md focus-visible:border-green-700 focus-visible:ring-2 focus-visible:ring-green-700/30 focus-visible:outline-none"
  {href}
  {title}
  target={external ? '_blank' : undefined}
  rel={external ? 'me noopener noreferrer' : undefined}
>
  <span
    class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-neutral-100 text-green-800 transition-colors group-hover:bg-neutral-200"
    aria-hidden="true"
  >
    <Icon name={icon} class={iconClass} size={20} />
  </span>
  <span class="min-w-0">
    <span class="block text-sm font-semibold text-ink">{label}</span>
    <span class="block truncate text-xs text-neutral-500 sm:text-sm">{detail}</span>
  </span>
</a>
