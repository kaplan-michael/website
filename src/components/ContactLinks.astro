  },
  {
    label: 'Email',
    detail: 'michael@kaplan.sh',
    href: 'mailto:michael@kaplan.sh',
    icon: 'heroicons:envelope-solid',
    iconClass: 'text-neutral-700',
  },
  {
    label: 'Phone',
    detail: '+420 777 050 427',
