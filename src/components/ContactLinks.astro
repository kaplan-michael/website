  },
  {
    label: 'Signal',
    detail: 'michael_kaplan.24',
    href: 'https://signal.me/#eu/6L5U01jfo5PHh0phtOEn7lO-G5qGuhPDJFfh4G7ysv5eVvVEQEdKuJo2WdV-lqzw',
    icon: 'simple-icons:signal',
    iconClass: 'text-[#3a76f0]',
