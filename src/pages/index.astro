---
import ContactLinks from "../components/ContactLinks.astro";
import Footer from "../components/Footer.astro";
import Layout from "../layouts/Layout.astro";

const title = "Michael Kaplan";
const description =
    "Michael Kaplan is an engineer based in Prague with experience across product security, software supply chain, Go, Kubernetes, and infrastructure. Open to remote EU roles.";
---

<Layout {title} {description}>
    <div class="flex min-h-dvh flex-col">
        <main
            class="mx-auto w-full max-w-5xl flex-1 px-4 py-8 sm:px-6 sm:py-14"
            aria-labelledby="profile-name"
        >
            <article
                class="overflow-hidden rounded-2xl bg-white shadow-xl ring-1 ring-black/5"
            >
                <section
                    class="flex flex-col items-center gap-5 p-6 text-center sm:flex-row sm:gap-7 sm:p-8 sm:text-left"
                >
                    <img
                        class="block size-36 shrink-0 rounded-full border-4 border-white object-cover shadow-md ring-2 ring-green-800/20 sm:size-44"
                        src="https://avatars.githubusercontent.com/u/16418072"
                        alt="Michael Kaplan"
                        width="240"
                        height="240"
                        fetchpriority="high"
                    />

                    <div>
                        <h1
                            id="profile-name"
                            class="text-4xl leading-none font-bold tracking-tight text-ink sm:text-6xl"
                        >
                            Michael Kaplan
                        </h1>
                        <p
                            class="mt-3 max-w-2xl text-base leading-relaxed text-neutral-600 sm:text-lg"
                        >
                            Engineer based in Prague with experience across
                            product security, software supply chain, Go,
                            Kubernetes, and infrastructure.
                        </p>
                        <p
                            class="mt-4 inline-flex items-center gap-2 rounded-full bg-green-50 px-3 py-1 text-sm font-semibold text-green-900"
                        >
                            <span
                                class="size-2 rounded-full bg-green-600"
                                aria-hidden="true"></span>
                            Remote EU only
                        </p>
                    </div>
                </section>

                <section
                    class="border-t border-neutral-200 px-6 py-5 text-left leading-relaxed text-neutral-700 sm:px-8 sm:py-6"
                    aria-label="About Michael Kaplan"
                >
                    <p>
                        Previously at Red Hat, currently working on security
                        tooling for SAP through EPAM. Finishing a BSc (Hons) in
                        Cyber Security at The Open University.
                    </p>
                </section>

                <section
                    class="border-t border-neutral-200 bg-neutral-50/70 px-4 py-5 sm:px-8 sm:py-7"
                    aria-labelledby="contact-heading"
                >
                    <h2
                        id="contact-heading"
                        class="mb-4 text-sm font-semibold tracking-widest text-neutral-500 uppercase"
                    >
                        Contact
                    </h2>
                    <ContactLinks />
                </section>
            </article>
        </main>

        <Footer />
    </div>
</Layout>
